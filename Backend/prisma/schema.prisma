generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())

  name            String
  email           String   @unique
  password        String

  role            String

  isActive        Boolean  @default(true)

  emailVerified   Boolean  @default(false)

  otp             String?
  otpExp          DateTime?

  createdAt       DateTime @default(now())
}